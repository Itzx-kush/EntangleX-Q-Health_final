# Copy to .env in the project root. This template contains no credentials.
# Relative storage roots are resolved against the project root, not the current shell.
QHEALTH_STORAGE_ROOT=.
# Empty means a local, single-user workstation only. Set a strong generated token
# before handling private data; the UI Connection settings accepts it in memory.
QHEALTH_API_TOKEN=
QHEALTH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
QHEALTH_TRUSTED_HOSTS=localhost,127.0.0.1,backend,testserver
QHEALTH_UPLOAD_LIMIT_MB=20
QHEALTH_MAX_ROWS=150000
QHEALTH_MAX_COLUMNS=200
QHEALTH_QUANTUM_MAX_SAMPLES=256
QHEALTH_MAX_QUEUED_JOBS=3
QHEALTH_LOG_LEVEL=INFO
