# Local Vite/Nginx same-origin proxy behavior.
VITE_API_BASE=/api
# Render static production is built with:
# VITE_API_BASE=https://entanglex-q-health-api.onrender.com/api
# Do NOT place API tokens in VITE_* variables: they are exposed in browser builds.

# Supabase Auth public browser configuration. Use the project URL and public
# anon/publishable key only. Never place service-role or OAuth secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
